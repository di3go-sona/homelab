apiVersion: k0sctl.k0sproject.io/v1beta1
kind: Cluster
metadata:
  name: k0s-cluster
  user: admin
spec:
  hosts:
{% for host in groups['cluster'] %}
    - ssh:
        address: {{ hostvars[host]['ansible_host'] }}
        user: {{ hostvars[host]['ansible_user'] }}
        # port: 22
        # keyPath: ~/.ssh/id_rsa
      role: {{ hostvars[host]['cluster_role'] }}
{% endfor %}
  options:
    wait:
      enabled: true
    drain:
      enabled: true
      gracePeriod: 2m0s
      timeout: 5m0s
      force: true
      ignoreDaemonSets: true
      deleteEmptyDirData: true
      podSelector: ""
      skipWaitForDeleteTimeout: 0s
    concurrency:
      limit: 30
      workerDisruptionPercent: 10
      uploads: 5
    evictTaint:
      enabled: false
      taint: k0sctl.k0sproject.io/evict=true
      effect: NoExecute
      controllerWorkers: false
